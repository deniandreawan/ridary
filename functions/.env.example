CREDENTIAL_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----\n"
CREDENTIAL_ISSUER="Ridary"
PUBLIC_KEY_ID="ridary-dev-1"
WEB_BASE_URL="http://localhost:5173"
