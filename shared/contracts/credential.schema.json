{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ridary.app/contracts/credential.schema.json",
  "title": "RidaryCredential",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "credentialId",
    "uid",
    "periodStart",
    "periodEnd",
    "mode",
    "score",
    "rideCount",
    "eventCount",
    "issuedAt",
    "expiresAt",
    "issuer",
    "publicKeyId",
    "payloadHash",
    "signature"
  ],
  "properties": {
    "credentialId": { "type": "string", "minLength": 8, "maxLength": 128 },
    "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
    "periodStart": { "type": "string", "format": "date-time" },
    "periodEnd": { "type": "string", "format": "date-time" },
    "mode": {
      "type": "string",
      "enum": ["motorcycle", "bicycle", "car", "running", "transit"]
    },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "rideCount": { "type": "integer", "minimum": 0 },
    "eventCount": { "type": "integer", "minimum": 0 },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "issuer": { "type": "string", "minLength": 1, "maxLength": 120 },
    "publicKeyId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "payloadHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/=]+$"
    }
  }
}
