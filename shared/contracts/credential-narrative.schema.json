{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ridary.app/contracts/credential-narrative.schema.json",
  "title": "CredentialNarrative",
  "type": "object",
  "additionalProperties": false,
  "required": ["headline", "summary", "strengths", "watchouts"],
  "properties": {
    "headline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "strengths": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "watchouts": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    }
  }
}
