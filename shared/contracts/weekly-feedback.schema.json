{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ridary.app/contracts/weekly-feedback.schema.json",
  "title": "WeeklyFeedback",
  "type": "object",
  "additionalProperties": false,
  "required": ["headline", "summary", "insights", "action"],
  "properties": {
    "headline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "insights": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    }
  }
}
